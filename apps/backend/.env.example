# Local (non-docker) development. Copy to .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_intake

PORT=3000
CORS_ORIGIN=http://localhost:5173

# "mock" needs no API key and returns deterministic canned analysis.
# "openai" calls the real OpenAI API using the credentials below.
AI_PROVIDER=mock
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
